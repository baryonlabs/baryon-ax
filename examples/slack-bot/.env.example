# Slack (Socket Mode: no public URL needed)
SLACK_BOT_TOKEN=xoxb-...        # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...        # Basic Information → App-Level Tokens (scope: connections:write)

# baryon-ax API
BARYON_API_URL=http://127.0.0.1:8000
BARYON_ORGANIZATION_ID=local-org
BARYON_ROLES=member             # roles every Slack user gets; documents are filtered by these
# BARYON_MODEL=                 # empty = server default model
# BARYON_API_TOKEN=             # sent as Authorization: Bearer … when the API sits behind a gateway
BARYON_TIMEOUT=120

# Behaviour
SLACK_SUBSCRIBE_THREADS=true    # answer follow-ups in a thread after the first @mention (OpenTag style)
SLACK_THREAD_TURNS=10           # thread messages sent as conversation history
SLACK_MAX_SOURCES=4
SLACK_SHOW_SNIPPETS=true        # quote the matched chunk under each source
LOG_LEVEL=INFO

# Proactive mode: ask people about questions the bot could not answer (empty channel = off)
# PROACTIVE_CHANNEL=C0123456789     # desk channel id
# PROACTIVE_INTERVAL_MINUTES=30
# PROACTIVE_HOURS=9-18              # local time window
# PROACTIVE_WEEKDAYS_ONLY=true
# PROACTIVE_MAX_PER_RUN=3
# PROACTIVE_MIN_OCCURRENCES=1
# PROACTIVE_SLACK_ONLY=false        # true = only gaps from questions asked in Slack
# PROACTIVE_MENTION=<!here>
# PROACTIVE_SERVICE_ROLES=admin     # gap list/dismiss are admin endpoints
# PROACTIVE_REANSWER=true
# PROACTIVE_STATE_PATH=.data/proactive_state.json
