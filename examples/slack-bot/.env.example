# Slack (Socket Mode: no public URL needed)
SLACK_BOT_TOKEN=xoxb-...        # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...        # Basic Information → App-Level Tokens (scope: connections:write)

# baryon-ax API
BARYON_API_URL=http://127.0.0.1:8000
BARYON_ROLES=member             # roles requested for every Slack user (X-On-Behalf-Of-Roles); capped by the service account
# BARYON_MODEL=                 # empty = server default model
BARYON_TIMEOUT=120

# Auth, AUTH_MODE=oidc: one service account acts on behalf of each Slack user (docs/auth-oidc.md §6).
# The service account needs the baryon-service and baryon-member groups (+ baryon-admin only for proactive mode).
# Organization comes from the token, so BARYON_ORGANIZATION_ID is not sent.
# BARYON_OIDC_TOKEN_URL=http://localhost:8180/realms/baryon-ax/protocol/openid-connect/token
# BARYON_OIDC_CLIENT_ID=baryon-slack-bot
# BARYON_OIDC_CLIENT_SECRET=    # keep it in your secret store, not in git
# BARYON_API_TOKEN=             # static Bearer token, used only when client credentials are not set

# Auth, AUTH_MODE=dev (no token set): the bot sends X-User-Id=slack-bot and this organization
BARYON_ORGANIZATION_ID=local-org

# Behaviour
SLACK_SUBSCRIBE_THREADS=true    # answer follow-ups in a thread after the first @mention (OpenTag style)
SLACK_THREAD_TURNS=10           # thread messages sent as conversation history
SLACK_MAX_SOURCES=4
SLACK_SHOW_SNIPPETS=true        # quote the matched chunk under each source
LOG_LEVEL=INFO

# Proactive mode: ask people about questions the bot could not answer (empty channel = off)
# PROACTIVE_CHANNEL=C0123456789     # desk channel id
# PROACTIVE_INTERVAL_MINUTES=30
# PROACTIVE_HOURS=9-18              # local time window (in Docker set TZ, e.g. TZ=Asia/Seoul; the image clock is UTC)
# PROACTIVE_WEEKDAYS_ONLY=true
# PROACTIVE_MAX_PER_RUN=3
# PROACTIVE_MIN_OCCURRENCES=1
# PROACTIVE_SLACK_ONLY=false        # true = only gaps from questions asked in Slack
# PROACTIVE_MENTION=<!here>
# PROACTIVE_SERVICE_ROLES=admin     # dev mode: the bot's own X-Roles (gap list/dismiss are admin endpoints)
# PROACTIVE_REANSWER=true
# PROACTIVE_STATE_PATH=.data/proactive_state.json
