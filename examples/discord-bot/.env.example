# Discord (Gateway: outbound WebSocket, no public URL needed)
DISCORD_TOKEN=                  # Developer Portal → your app → Bot → Reset Token

# baryon-ax API
BARYON_API_URL=http://127.0.0.1:8000
BARYON_ROLES=member             # roles requested for every Discord user (X-On-Behalf-Of-Roles); capped by the service account
# BARYON_MODEL=                 # empty = server default model
BARYON_TIMEOUT=120

# Auth, AUTH_MODE=oidc: one service account acts on behalf of each Discord user (docs/auth-oidc.md §6).
# The service account needs the baryon-service and baryon-member groups (+ baryon-admin only for proactive mode).
# Organization comes from the token, so BARYON_ORGANIZATION_ID is not sent.
# BARYON_OIDC_TOKEN_URL=http://localhost:8180/realms/baryon-ax/protocol/openid-connect/token
# BARYON_OIDC_CLIENT_ID=baryon-discord-bot
# BARYON_OIDC_CLIENT_SECRET=    # keep it in your secret store, not in git
# BARYON_API_TOKEN=             # static Bearer token, used only when client credentials are not set

# Auth, AUTH_MODE=dev (no token set): the bot sends X-User-Id=discord-bot and this organization
BARYON_ORGANIZATION_ID=local-org

# Behaviour
DISCORD_SUBSCRIBE_THREADS=true  # answer follow-ups in the bot's threads without another mention
DISCORD_THREAD_TURNS=10
DISCORD_MAX_SOURCES=4
DISCORD_SHOW_SNIPPETS=true
LOG_LEVEL=INFO

# Proactive mode: ask people about questions the bot could not answer (empty channel = off)
# PROACTIVE_CHANNEL=123456789012345678   # desk channel id (Developer Mode → right-click channel → Copy Channel ID)
# PROACTIVE_INTERVAL_MINUTES=30
# PROACTIVE_HOURS=9-18
# PROACTIVE_WEEKDAYS_ONLY=true
# PROACTIVE_MAX_PER_RUN=3
# PROACTIVE_MIN_OCCURRENCES=1
# PROACTIVE_DISCORD_ONLY=false           # true = only gaps from questions asked on Discord
# PROACTIVE_MENTION=@here                # or <@&ROLE_ID> to ping a role
# PROACTIVE_SERVICE_ROLES=admin          # dev mode: the bot's own X-Roles (gap list/dismiss are admin endpoints)
# PROACTIVE_REANSWER=true
# PROACTIVE_STATE_PATH=.data/proactive_state.json
