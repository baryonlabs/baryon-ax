# Discord (Gateway: outbound WebSocket, no public URL needed)
DISCORD_TOKEN=                  # Developer Portal → your app → Bot → Reset Token

# baryon-ax API
BARYON_API_URL=http://127.0.0.1:8000
BARYON_ORGANIZATION_ID=local-org
BARYON_ROLES=member             # roles every Discord user gets; documents are filtered by these
# BARYON_MODEL=                 # empty = server default model
# BARYON_API_TOKEN=             # sent as Authorization: Bearer … when the API sits behind a gateway
BARYON_TIMEOUT=120

# Behaviour
DISCORD_SUBSCRIBE_THREADS=true  # answer follow-ups in the bot's threads without another mention
DISCORD_THREAD_TURNS=10
DISCORD_MAX_SOURCES=4
DISCORD_SHOW_SNIPPETS=true
LOG_LEVEL=INFO

# Proactive mode: ask people about questions the bot could not answer (empty channel = off)
# PROACTIVE_CHANNEL=123456789012345678   # desk channel id (Developer Mode → right-click channel → Copy Channel ID)
# PROACTIVE_INTERVAL_MINUTES=30
# PROACTIVE_HOURS=9-18
# PROACTIVE_WEEKDAYS_ONLY=true
# PROACTIVE_MAX_PER_RUN=3
# PROACTIVE_MIN_OCCURRENCES=1
# PROACTIVE_DISCORD_ONLY=false           # true = only gaps from questions asked on Discord
# PROACTIVE_MENTION=@here                # or <@&ROLE_ID> to ping a role
# PROACTIVE_SERVICE_ROLES=admin
# PROACTIVE_REANSWER=true
# PROACTIVE_STATE_PATH=.data/proactive_state.json
