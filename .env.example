MODEL_NAME=qwen2.5:7b
MODEL_HOST_URL=
MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Compose only: container -> host Ollama (start scripts/ollama_proxy.py first)
MODEL_BASE_URL_DOCKER=http://host.docker.internal:11435/v1
MODEL_API_KEY=ollama
MODEL_TIMEOUT_SECONDS=180
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
# Authentication: dev (trusted headers) or oidc (Keycloak / Entra ID / any OIDC issuer)
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_ROLE=baryon-admin
OIDC_MEMBER_ROLE=baryon-member
OIDC_LEGAL_ROLE=baryon-legal
OIDC_ORG_CLAIM=organization
OIDC_DEFAULT_ORG=local-org
OIDC_USER_CLAIM=preferred_username
OIDC_PUBLIC_PATHS=/health,/docs*,/redoc*,/openapi.json,/v1/open-source
# Local Keycloak uses http://localhost:8180. Never enable this in production.
OIDC_ALLOW_INSECURE_ISSUER=false
DOCUMENT_STORE=/tmp/baryon-ax-documents
AUDIT_LOG=/tmp/baryon-ax-audit/events.jsonl
MAX_DOCUMENT_BYTES=20000000
# Optional parser sidecars. Leave empty to accept text/markdown only.
KORDOC_URL=
KORDOC_CMD=
DOCLING_URL=
DOCLING_CMD=
TIKA_URL=
PARSER_TIMEOUT_SECONDS=180
INGEST_QUEUE_MAXSIZE=32
INGEST_MAX_IN_FLIGHT=4
INGEST_BATCH_SIZE=8
INGEST_BATCH_TIMEOUT_SECONDS=0.5
INGEST_MAX_RETRIES=2
GAP_STORE=/tmp/baryon-ax-gaps/gaps.jsonl
ONTOLOGY_STORE=/tmp/baryon-ax-ontology
TACIT_STORE=/tmp/baryon-ax-tacit/tacit.jsonl
FEEDBACK_STORE=/tmp/baryon-ax-feedback/feedback.jsonl
DATABASE_URL=postgresql://baryon:change-me-before-production@127.0.0.1:5433/baryon
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=baryon_documents
QDRANT_REINDEX_ON_START=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RATE_LIMIT_PER_MINUTE=60
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
POSTGRES_DB=baryon
POSTGRES_USER=baryon
POSTGRES_PASSWORD=change-me-before-production
WEB_PORT=3001

MEM0_ENABLED=true
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_BASE_URL=http://127.0.0.1:11434/v1
MEM0_LLM_API_KEY=ollama
MEM0_LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MEM0_HISTORY_DB=/tmp/baryon-ax-mem0/history.db
MEM0_TELEMETRY=false
MODEL_DISABLE_THINKING=false
MODEL_CHAT_TEMPLATE_KWARGS=

MODEL_PROMPT_PROFILE=auto

MODEL_SYSTEM_PROMPT=

RETRIEVAL_MIN_SCORE=0.3
SYSTEM_METRICS_ENABLED=true
DOCKER_PROJECT=baryon-ax
DOCKER_GID=0
DOCKER_SOCKET=/var/run/docker.sock
QDRANT_DASHBOARD_URL=http://127.0.0.1:6333/dashboard
LANGFUSE_DASHBOARD_URL=http://127.0.0.1:3000
MODEL_SERVER_URL=
PGADMIN_URL=
REDIS_INSIGHT_URL=
MEMORY_CONTEXT_LIMIT=5
LOG_LEVEL=INFO
