MODEL_NAME=qwen2.5:7b
MODEL_HOST_URL=
MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Compose only: container -> host Ollama (start scripts/ollama_proxy.py first)
MODEL_BASE_URL_DOCKER=http://host.docker.internal:11435/v1
MODEL_API_KEY=ollama
MODEL_TIMEOUT_SECONDS=180
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
# Authentication: dev (trusted headers) or oidc (Keycloak / Entra ID / any OIDC issuer)
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_ROLE=baryon-admin
OIDC_MEMBER_ROLE=baryon-member
OIDC_LEGAL_ROLE=baryon-legal
OIDC_ORG_CLAIM=organization
OIDC_DEFAULT_ORG=local-org
OIDC_USER_CLAIM=preferred_username
OIDC_PUBLIC_PATHS=/health,/docs*,/redoc*,/openapi.json,/v1/open-source
# Local Keycloak uses http://localhost:8180. Never enable this in production.
OIDC_ALLOW_INSECURE_ISSUER=false
# Delegated identity for bots / MCP clients (docs/auth-oidc.md section 6).
# Only tokens carrying this role may send X-On-Behalf-Of.
OIDC_SERVICE_ROLE=baryon-service
# Optional comma-separated allowlist of delegated user id prefixes, e.g. slack:,discord:
OIDC_DELEGATION_USER_PREFIXES=
# Max auth.failed audit events per minute per API process (excess is counted, not stored).
AUTH_FAILED_AUDIT_PER_MINUTE=60
# Multi-tenancy (docs/multi-tenancy.md): single (default, one organization) or pooled (shared instance).
# pooled rejects organizations that are not active registered tenants and requires AUTH_MODE=oidc.
TENANCY_MODE=single
# Tenant registry, usage counters and Mem0 user index (pooled only). Use a persistent volume.
TENANT_STORE=/data/tenants
# Seconds between usage counter flushes to disk.
USAGE_FLUSH_SECONDS=5
# IdP group/role for platform operators (manages tenants; distinct from tenant admins).
OIDC_PLATFORM_ADMIN_ROLE=baryon-platform-admin
# Pooled only: allow connector tool calls through the single shared MCP gateway credential.
TENANT_SHARED_GATEWAY_ALLOWED=false
# Web login (build-time; read by apps/web via Vite). dev keeps the role switcher.
VITE_AUTH_MODE=dev
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=baryon-ax-web
# Optional MCP gateway (ContextForge profile: docker-compose.mcp.yml)
# Expose search/answers/knowledge-gap tools at POST /mcp (docs/mcp-server.md)
MCP_SERVER_ENABLED=true
MCP_GATEWAY_URL=
DOCUMENT_STORE=/tmp/baryon-ax-documents
AUDIT_LOG=/tmp/baryon-ax-audit/events.jsonl
MAX_DOCUMENT_BYTES=20000000
# After uploads, open knowledge gaps are re-checked in a background worker (coalesced per organization),
# so bulk uploads do not wait for it. inline = re-check during each upload, as before.
GAP_RECHECK_MODE=background
# Optional parser sidecars. Leave empty to accept text/markdown only.
KORDOC_URL=
KORDOC_CMD=
DOCLING_URL=
DOCLING_CMD=
TIKA_URL=
PARSER_TIMEOUT_SECONDS=180
INGEST_QUEUE_MAXSIZE=32
INGEST_MAX_IN_FLIGHT=4
INGEST_BATCH_SIZE=8
INGEST_BATCH_TIMEOUT_SECONDS=0.5
INGEST_MAX_RETRIES=2
GAP_STORE=/tmp/baryon-ax-gaps/gaps.jsonl
ONTOLOGY_STORE=/tmp/baryon-ax-ontology
TACIT_STORE=/tmp/baryon-ax-tacit/tacit.jsonl
FEEDBACK_STORE=/tmp/baryon-ax-feedback/feedback.jsonl
DATABASE_URL=postgresql://baryon:change-me-before-production@127.0.0.1:5433/baryon
REDIS_URL=redis://127.0.0.1:6379/0
# Vector index (docs/retrieval.md). Host runs use this URL; Docker Compose points the API at the
# bundled qdrant service instead (QDRANT_URL_DOCKER, default http://qdrant:6333; set it empty to turn vectors off).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=baryon_documents
# auto: index stored documents in the background when the collection is empty (first start after migration);
# true: reindex everything on every start; false: never (run `python -m baryon.reindex` yourself).
QDRANT_REINDEX_ON_START=auto
# Better Korean retrieval: EMBEDDING_MODEL=intfloat/multilingual-e5-large with EMBEDDING_DIMENSION=1024
# (2.2 GB download). A different model needs a new QDRANT_COLLECTION, or `python -m baryon.reindex --recreate`.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
# Hosted embeddings instead of local FastEmbed: any OpenAI-compatible /v1/embeddings endpoint.
# EMBEDDING_QUERY_MODEL is for asymmetric models with a separate query encoder (defaults to EMBEDDING_MODEL).
EMBEDDING_PROVIDER=fastembed
# EMBEDDING_BASE_URL=https://api.example.com/v1   (defaults to MODEL_BASE_URL)
# EMBEDDING_API_KEY=
# EMBEDDING_QUERY_MODEL=
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_MAX_CHARS=6000   (embedded text is truncated to fit the model context; stored chunks stay whole)
RATE_LIMIT_PER_MINUTE=60
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
POSTGRES_DB=baryon
POSTGRES_USER=baryon
POSTGRES_PASSWORD=change-me-before-production
WEB_PORT=3001

MEM0_ENABLED=true
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_BASE_URL=http://127.0.0.1:11434/v1
MEM0_LLM_API_KEY=ollama
MEM0_LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MEM0_HISTORY_DB=/tmp/baryon-ax-mem0/history.db
MEM0_TELEMETRY=false
MODEL_DISABLE_THINKING=false
MODEL_CHAT_TEMPLATE_KWARGS=

MODEL_PROMPT_PROFILE=auto

MODEL_SYSTEM_PROMPT=

RETRIEVAL_MIN_SCORE=0.3
# hybrid (default): Qdrant vectors + lexical, weighted reciprocal rank fusion. vector: Qdrant only.
# lexical: word matching only (the pre-Qdrant behaviour; an instant rollback that needs no reindex).
# Without a reachable Qdrant every mode falls back to lexical.
RETRIEVAL_MODE=hybrid
# RETRIEVAL_CANDIDATES=8          hits each retriever contributes before fusion (default 2x the result limit)
# RETRIEVAL_VECTOR_WEIGHT=1.0     fusion weights
# RETRIEVAL_LEXICAL_WEIGHT=1.0
# RETRIEVAL_RRF_K=60
SYSTEM_METRICS_ENABLED=true
DOCKER_PROJECT=baryon-ax
DOCKER_GID=0
DOCKER_SOCKET=/var/run/docker.sock
# Settings -> admin links. A tool's button appears only when the tool itself is configured
# (Qdrant: QDRANT_URL, Langfuse: LANGFUSE_ENABLED=true, pgAdmin: DATABASE_URL, Redis Insight: REDIS_URL).
QDRANT_DASHBOARD_URL=http://127.0.0.1:6333/dashboard
LANGFUSE_DASHBOARD_URL=http://127.0.0.1:3000
PGADMIN_URL=
REDIS_INSIGHT_URL=
# LLM gateway: the "Model server" button opens this page (e.g. the operations dashboard, http://<ops-host>:8095/#gateway).
MODEL_SERVER_URL=
# Optional status document with the fallback order and live health per backend (see apps/api/src/baryon/gateway_status.py),
# e.g. http://<ops-host>:8095/api/gateway. Shown to operators in Settings; key values are never displayed.
MODEL_GATEWAY_STATUS_URL=
# "bearer" sends MODEL_API_KEY to the status URL (only for a gateway that protects it, like deploy/aws/gateway).
MODEL_GATEWAY_STATUS_AUTH=none
MEMORY_CONTEXT_LIMIT=5
LOG_LEVEL=INFO

# ContextForge service token for MCP tool calls
MCP_GATEWAY_TOKEN=

# Voice dictation (docker-compose.voice.yml, docs/voice.md). Leave STT_BASE_URL empty to hide the mic button.
STT_BASE_URL=
STT_API_KEY=
STT_DEFAULT_MODEL=sensevoice-ko
STT_MAX_UPLOAD_BYTES=8388608

# Voice secretary (apps/secretary on your workstation, docs/voice-secretary.md). Owner-only.
SECRETARY_URL=
SECRETARY_API_KEY=
SECRETARY_OWNERS=

# Phone (docker-compose.phone.yml, docs/phone.md): call the secretary from a SIP app over your tailnet.
PHONE_USER=
PHONE_PASSWORD=
PHONE_BIND=127.0.0.1
PHONE_EXTERNAL_ADDRESS=

# Web pages as knowledge: a link in a question is read, stored and cited (apps/api/src/baryon/web.py)
WEB_FETCH_ENABLED=true
# Allow intranet addresses (10.x, 192.168.x, localhost). Off: the server never fetches internal pages for a user.
WEB_FETCH_ALLOW_PRIVATE=false
WEB_FETCH_MAX_BYTES=3000000
# A page asked about again within this many hours is reused, not fetched again
WEB_REFRESH_HOURS=24
# Whole-site crawls (POST /v1/crawls, the web screen, "크롤링해 줘" in chat, MCP crawl_site)
WEB_CRAWL_MAX_PAGES=200
WEB_CRAWL_DELAY=0.5
WEB_CRAWL_PER_ORG=2
WEB_CRAWL_CHAT_PAGES=50
