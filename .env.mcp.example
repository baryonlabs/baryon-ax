# ContextForge / MCP gateway development profile.
# Copy to .env.mcp and replace every change-me value before starting.
MCP_GATEWAY_IMAGE=ghcr.io/ibm/mcp-context-forge:latest
MCP_GATEWAY_PORT=4444
# 127.0.0.1 for local; 172.17.0.1 so API containers can reach it via host.docker.internal
MCP_GATEWAY_BIND=127.0.0.1
MCP_GATEWAY_ADMIN_EMAIL=admin@example.com
MCP_GATEWAY_ADMIN_PASSWORD=change-me-before-use
MCP_GATEWAY_JWT_SECRET=change-me-32-chars-minimum
MCP_GATEWAY_ENCRYPTION_SECRET=change-me-32-chars-minimum
