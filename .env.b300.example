# Copy to .env on the B300 host and adjust passwords.
# The platform runs on B300; vLLM runs on B300 GPU 7 behind a loopback proxy.
BIND_HOST=127.0.0.1
API_PORT=8100
WEB_PORT=3101
POSTGRES_PORT=5533
REDIS_PORT=6479
QDRANT_HTTP_PORT=6433
QDRANT_GRPC_PORT=6434

MODEL_HOST_URL=http://host.docker.internal:8021
MODEL_NAME=baryon-ax-qwen
MODEL_API_KEY=ollama
MODEL_DISABLE_THINKING=true
MODEL_TIMEOUT_SECONDS=180

ALLOWED_ORIGINS=http://localhost:3101,http://127.0.0.1:3101
DOCUMENT_STORE=/data/documents
AUDIT_LOG=/data/audit/events.jsonl
MAX_DOCUMENT_BYTES=2000000

QDRANT_COLLECTION=baryon_documents
QDRANT_REINDEX_ON_START=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RATE_LIMIT_PER_MINUTE=60

LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-b300-baryon-ax
LANGFUSE_SECRET_KEY=change-me-langfuse-secret
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret-32chars
LANGFUSE_SALT=change-me-langfuse-salt-32chars

MEM0_ENABLED=true
MEM0_LLM_PROVIDER=openai
MEM0_LLM_BASE_URL=http://host.docker.internal:8021/v1
MEM0_LLM_MODEL=baryon-ax-qwen
MEM0_LLM_API_KEY=ollama
MEM0_TELEMETRY=false
MEM0_HISTORY_DB=/data/mem0/history.db

POSTGRES_DB=baryon
POSTGRES_USER=baryon
POSTGRES_PASSWORD=change-me-b300

MODEL_PROMPT_PROFILE=qwen35

MODEL_SYSTEM_PROMPT=

RETRIEVAL_MIN_SCORE=0.3
SYSTEM_METRICS_ENABLED=true
DOCKER_PROJECT=baryon-ax
DOCKER_GID=113
DOCKER_SOCKET=/var/run/docker.sock
QDRANT_DASHBOARD_URL=http://127.0.0.1:6433/dashboard
LANGFUSE_DASHBOARD_URL=http://127.0.0.1:3102
MODEL_SERVER_URL=http://127.0.0.1:8020/docs
PGADMIN_URL=
REDIS_INSIGHT_URL=
HOST_HOSTNAME=cloud-Ox5IZb
